# Bootstrap profile cloud.staging — replace with application-specific values.
SDKWORK_MCP_DEPLOYMENT_PROFILE=cloud
SDKWORK_MCP_ENVIRONMENT=staging
SDKWORK_MCP_PROFILE_ID=cloud.staging
SDKWORK_MCP_APPLICATION_PUBLIC_HTTP_URL=https://mcp-staging.sdkwork.com
