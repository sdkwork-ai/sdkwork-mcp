SDKWORK_CORS_ALLOWED_ORIGINS=https://mcp.sdkwork.com,https://mcp.birdcoder.com,https://mcp.dtupay.com,https://mcp.noaper.com,https://mcp.sdkwork.cn,https://mcp.birdcoder.cn,https://mcp.dtupay.cn,https://mcp.noaper.cn,https://mcp.skubc.com,https://mcp.skubc.cn,https://mcp.zowalk.com,https://mcp.zowalk.cn,https://mcp.offer86.com,https://mcp.offer86.cn,https://mcp.86offer.com,https://mcp.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
