# Bootstrap profile cloud.demo — cloud independent demonstration deployment.
SDKWORK_MCP_DEPLOYMENT_PROFILE=cloud
SDKWORK_MCP_ENVIRONMENT=demo
SDKWORK_MCP_PROFILE_ID=cloud.demo
SDKWORK_MCP_APPLICATION_PUBLIC_HTTP_URL=https://mcp-demo.sdkwork.com
