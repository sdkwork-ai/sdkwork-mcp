# Bootstrap profile cloud.demo — cloud independent demonstration deployment.
SDKWORK_MCP_DEPLOYMENT_PROFILE=cloud
SDKWORK_MCP_ENVIRONMENT=demo
SDKWORK_MCP_PROFILE_ID=cloud.demo
SDKWORK_MCP_APPLICATION_PUBLIC_HTTP_URL=https://mcp-demo.sdkwork.com
SDKWORK_MCP_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
SDKWORK_MCP_WEB_DEV_INGRESS_BIND=127.0.0.1:5630
SDKWORK_MCP_PC_INTERNAL_DEV_PORT=5632
SDKWORK_MCP_H5_INTERNAL_DEV_PORT=5633


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_MCP_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
