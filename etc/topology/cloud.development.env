# cloud.development
SDKWORK_MCP_DEPLOYMENT_PROFILE=cloud
SDKWORK_MCP_ENVIRONMENT=development
SDKWORK_MCP_PROFILE_ID=cloud.development
SDKWORK_MCP_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
SDKWORK_MCP_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_MCP_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_MCP_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_MCP_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_MCP_WEB_DEV_INGRESS_BIND=127.0.0.1:5630
SDKWORK_MCP_PC_INTERNAL_DEV_PORT=5632
SDKWORK_MCP_H5_INTERNAL_DEV_PORT=5633


# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
SDKWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5630,http://localhost:5630,https://mcp-dev.sdkwork.com,http://mcp-dev.sdkwork.com,https://mcp-dev.birdcoder.com,http://mcp-dev.birdcoder.com,https://mcp-dev.dtupay.com,http://mcp-dev.dtupay.com,https://mcp-dev.noaper.com,http://mcp-dev.noaper.com,https://mcp-dev.sdkwork.cn,http://mcp-dev.sdkwork.cn,https://mcp-dev.birdcoder.cn,http://mcp-dev.birdcoder.cn,https://mcp-dev.dtupay.cn,http://mcp-dev.dtupay.cn,https://mcp-dev.noaper.cn,http://mcp-dev.noaper.cn,https://mcp-dev.skubc.com,http://mcp-dev.skubc.com,https://mcp-dev.skubc.cn,http://mcp-dev.skubc.cn,https://mcp-dev.zowalk.com,http://mcp-dev.zowalk.com,https://mcp-dev.zowalk.cn,http://mcp-dev.zowalk.cn,https://mcp-dev.offer86.com,http://mcp-dev.offer86.com,https://mcp-dev.offer86.cn,http://mcp-dev.offer86.cn,https://mcp-dev.86offer.com,http://mcp-dev.86offer.com,https://mcp-dev.86offer.cn,http://mcp-dev.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
